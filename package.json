{
  "name": "com.diettracker.app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:fast": "node scripts/dev.js --skip-build",
    "emulator": "node scripts/dev.js --emulator-only",
    "emulator:apk": "node scripts/dev.js --apk",
    "emulator:stop": "node scripts/dev.js --stop",
    "apk": "scripts\\build-apk.bat",
    "start": "expo start",
    "ios": "expo run:ios",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "generate": "node scripts/generate.js",
    "eas:login": "npx eas-cli login",
    "eas:android:dev": "npx eas-cli build --platform android --profile development"
  },
  "dependencies": {
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "^58.0.21",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "js-sha256": "^1.0.0",
    "jszip": "^3.10.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "^4.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "~30.5.2",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
